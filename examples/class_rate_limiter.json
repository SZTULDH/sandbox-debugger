  "description": "实现类 RateLimiter(limit: int, window_sec: float)。方法 allow(key: str, now: float) -> bool：在窗口 (now-window_sec, now] 内同一 key 最多 limit 次返回 True，并记一次请求；超出返回 False。",
  "class_name": "RateLimiter",
  "entry_point": "allow",
  "init_args": [2, 10.0],
  "function_signature": "class RateLimiter:\n    def __init__(self, limit: int, window_sec: float): ...\n    def allow(self, key: str, now: float) -> bool: ...",
  "language": "python",
  "dependencies": [],
  "public_tests": [
    { "method": "allow", "args": ["u1", 1.0], "expected": true },
    { "method": "allow", "args": ["u1", 2.0], "expected": true },
    { "method": "allow", "args": ["u1", 3.0], "expected": false },
    { "method": "allow", "args": ["u2", 3.0], "expected": true }
